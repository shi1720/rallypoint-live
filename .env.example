# Native Next development. Copy to .env.local, which is ignored by Git.
# On Cloud Run use the attached service account and Secret Manager, no JSON key.
GOOGLE_CLOUD_PROJECT=your-firebase-project
FIRESTORE_DATABASE_ID=rallypoint
FIREBASE_WEB_CONFIG={"apiKey":"PUBLIC_FIREBASE_WEB_KEY","authDomain":"your-firebase-project.firebaseapp.com","projectId":"your-firebase-project","appId":"YOUR_WEB_APP_ID"}
SITE_URL=http://127.0.0.1:3000
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=rallypoint-replies
# Optional until you connect a Twitch developer app.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Webhook: openssl rand -hex 32
# Encryption key: openssl rand -base64 32
TWITCH_WEBHOOK_SECRET=
TOKEN_ENCRYPTION_KEY=
