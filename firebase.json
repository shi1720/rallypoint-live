  "hosting": {
    "site": "rallypoint-desk",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{"source": "**", "run": {"serviceId": "rallypoint", "region": "us-central1"}}]
